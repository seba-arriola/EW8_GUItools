{
  "$schema": "https://opencode.ai/config.json",
  // Default caro SOLO para plan/build
  "model": "opencode-go/deepseek-v4.1-flash",
  // Títulos/resúmenes son trabajo liviano: que no gasten cupo de Go
  "small_model": "tokenharbor/deepseek-v4.1-flash:free",
  // Permisos compartidos V2. Gana la ÚLTIMA regla que coincide: las reglas de
  // cada agente se añaden DESPUÉS. OJO: un `shell *` allow de agente BORRA los
  // deny de aquí abajo salvo que el agente los vuelva a declarar después
  // (lo hacen build/runner; y el test test_agent_permissions.sh lo verifica).
  "permissions": [
    { "action": "shell", "resource": "sudo *",             "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *",           "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *",           "effect": "deny" },
    { "action": "shell", "resource": "git add *",          "effect": "deny" },
    { "action": "shell", "resource": "git commit *",       "effect": "deny" },
    { "action": "shell", "resource": "git push *",         "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask"  },
    { "action": "shell", "resource": "git clean *",        "effect": "ask"  }
  ],
  // Policies V2: hard-deny binario. Se evalúa DESPUÉS de las reglas y de las
  // aprobaciones, así que ni un `allow` de agente ni un "Allow always" pueden
  // levantarlo (mensaje: "Blocked by configuration policy").
  // Objetivo: que ningún agente pueda leer credenciales del entorno.
  "policies": [
    { "action": "tool.use", "resource": "read:*service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*db.env",       "effect": "deny" }
  ],
  "providers": {
    "opencode-go": {
      // Temperatura real por modelo: el frontmatter de agente ya no la envia en V2
      "models": {
        "deepseek-v4.1-flash": {
          "body": { "temperature": 0.2 }
        },
        "muse-spark-1.3-contributor": {
          "body": { "temperature": 0 }
        }
      }
    },
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama Local Xeon",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder-1.5b-16k": {
          "name": "Qwen 1.5B 16k"
        },
        "qwen2.5-coder-3b-16k": {
          "name": "Qwen 3B 16k"
        },
        "qwen2.5-coder-7b-32k": {
          "name": "Qwen 7B 32k"
        },
        "qwen3:8b": {
          "name": "Qwen3 8B reservado"
        },
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B reservado"
        }
      }
    },
    "tokenharbor": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Token Harbor",
      "settings": {
        "baseURL": "https://tokenharbor.ai/v1"
      },
      "models": {
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (free)"
        },
        "deepseek-v4-flash:free": {
          "name": "DeepSeek V4 Flash (free)"
        },
        "mimo-v2.5:free": {
          "name": "MiMo V2.5 (free)"
        }
        // "qwen3.8-flash:free": { "name": "Qwen3.8 Flash (free, por tiempo limitado)" }
      }
    }
  },
  "compaction": {
    "auto": true
  },
  "instructions": ["AGENTS.md"]
}