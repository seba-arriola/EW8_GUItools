# Credenciales PostgreSQL para la información hipocentral (EW8_GUItools).
#
# Copiar este archivo a `db.env` (mismo directorio) y ajustar si hace falta.
# `db.env` NO se versiona (ver .gitignore). Las variables de entorno tienen
# precedencia sobre este archivo al conectar desde los módulos.
#
# --- Conexión de los módulos (libpq) -----------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5435
DB_NAME=csn_hypo
DB_USER=csn
DB_PASSWORD=csn

# --- Inicialización del contenedor PostgreSQL (docker compose) ---------------
# Deben coincidir con DB_USER/DB_PASSWORD/DB_NAME de arriba.
POSTGRES_USER=csn
POSTGRES_PASSWORD=csn
POSTGRES_DB=csn_hypo
