# ===========================================================================
# EW8_GUItools — .gitignore
# Se versionan: api_report_locs/, ew_gui_tools/, tank_tools/ y
# run_working_v8/params/ (config de ejemplo). Sin binarios ni runtime.
# Los archivos sueltos de la raíz NO se listan aquí: se deciden manualmente.
# ===========================================================================

# --- 1. Infraestructura y datos que NO se versionan -------------------------
earthworm_8.0/
glass3/
kafka/
kafka-data/
kafka-logs/
mseed/
tank_repo/
replay/
picks/
runs/

# --- 2. Runtime de EarthWorm ------------------------------------------------
