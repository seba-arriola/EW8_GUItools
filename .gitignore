# ===========================================================================
# EW8_GUItools — .gitignore
# Se versionan: ew_gui_tools/, run_working_v8/params/ (config de ejemplo) y
# ew_8.0/ (subconjunto de la instalación EarthWorm 8: headers, librerías y los
# binarios de fabrica; los binarios que compilan NUESTROS modulos NO se
# versionan, ver §3b).
# Los archivos sueltos de la raíz NO se listan aquí: se deciden manualmente.
# ===========================================================================

# --- 1. Infraestructura y datos que NO se versionan -------------------------
# Instalación EarthWorm COMPLETA (legado): vive fuera del repo. El subconjunto
# que sí se versiona está en ew_8.0/ (ver §3b).
earthworm_8.0/
report_images/
run_working_v8/wstore/
db/backups/
# --- 2. Runtime de EarthWorm ------------------------------------------------
run_working_v8/log/*.log
run_working_v8/log/*.lock
run_working_v8/log/.noexec_fifo.txt
# Directorios de trabajo que cada modulo crea en runtime (no se versionan):
#   hyp2000_ring/ = arcIn/arcOut · nlloc_ring/ = obs.nll, nll_ring.in, loc/
#   csnhypodbp/   = estado manual + corridas Mww
#   csnwphase/    = corpus de validacion (tools/run_corpus.sh)
run_working_v8/hyp2000_ring/
run_working_v8/nlloc_ring/
run_working_v8/csnhypodbp/
run_working_v8/csnwphase/
run_working_v8/params/db.env

# ===========================================================================
# Artefactos dentro de los directorios versionados
# ===========================================================================

# --- 3. Objetos, librerías y símbolos ---------------------------------------
# (los patrones *.o/*.a/*.so/*.dSYM de aquí abajo van DESPUÉS a propósito: el
#  "!*.*" de la regla general re-incluye objetos y estos los vuelven a ignorar)

# --- 3a. Binarios de módulo y de test (regla general, módulos presentes/futuros)
# Los binarios NO llevan extensión; sus fuentes/datos SÍ. Se ignora lo sin
# extensión en la raíz del módulo y los binarios de test (test_*/gen_*),
# preservando todo lo que tenga extensión y los Makefile.
/ew_gui_tools/*/*
!/ew_gui_tools/*/*/
!/ew_gui_tools/*/*.*
!/ew_gui_tools/*/Makefile*

/ew_gui_tools/**/test_*
!/ew_gui_tools/**/test_*.*
/ew_gui_tools/**/gen_*
!/ew_gui_tools/**/gen_*.*
/ew_gui_tools/**/build/

*.o
*.a
*.so
*.so.*
*.dylib
*.dSYM/

# --- 3b. ew_8.0/: instalación EarthWorm vendorizada -------------------------
# Los .a/.o de ew_8.0/lib SÍ se versionan (el §3 los ignora: hay que re-incluir).
!/ew_8.0/lib/*.a
!/ew_8.0/lib/*.o
# Los binarios de FABRICA de ew_8.0/bin SÍ se versionan. Estos son los que
# `make install` de los módulos deja ahí: se ignoran (lista derivada de las
# recetas install_bin.sh de cada Makefile; ver common/tools/check_install.sh).
/ew_8.0/bin/csnloc
/ew_8.0/bin/pickS
/ew_8.0/bin/csnmags
/ew_8.0/bin/csnhypodbp
/ew_8.0/bin/csnrv
/ew_8.0/bin/csntvp
/ew_8.0/bin/csnstaevdisp
/ew_8.0/bin/ew_controller
/ew_8.0/bin/hyp2000_ring
/ew_8.0/bin/nlloc_ring
/ew_8.0/bin/csnwphase
/ew_8.0/bin/hypodb_ingest
/ew_8.0/bin/wstore_ingest
/ew_8.0/bin/tank2store
/ew_8.0/bin/store2tank
/ew_8.0/bin/wstore_query
/ew_8.0/bin/wstore_prune

# --- 4. Ejecutables generados por los Makefiles (sin extensión) -------------
/ew_gui_tools/csnloc/csnloc
/ew_gui_tools/csnloc/csnloc_asan
/ew_gui_tools/csnloc/test/test_*
!/ew_gui_tools/csnloc/test/test_*.c
!/ew_gui_tools/csnloc/test/test_*.sh
!/ew_gui_tools/csnloc/test/test_*.txt
/ew_gui_tools/csnloc/test/gen_offline_picks
/ew_gui_tools/csnhypodbp/csnhypodbp
/ew_gui_tools/csnhypodbp/test_filter
/ew_gui_tools/csnrv/csnrv
/ew_gui_tools/csntvp/csntvp
/ew_gui_tools/csntvp/test_filter
/ew_gui_tools/csnstaevdisp/csnstaevdisp
/ew_gui_tools/csnstaevdisp/test/test_data
/ew_gui_tools/ew_controller/ew_controller
/ew_gui_tools/ew_controller/tests/fake_status
/ew_gui_tools/_legacy_atwc/loc_wcatwc/loc_wcatwc
/ew_gui_tools/_legacy_atwc/pick_wcatwc/pick_wcatwc
/ew_gui_tools/_legacy_atwc/disk_wcatwc/disk_wcatwc

# --- ejecutables sin extensión de los módulos nuevos ---
/ew_gui_tools/csnloc/ttpred
/ew_gui_tools/common/build/
/ew_gui_tools/pickS/pickS
/ew_gui_tools/pickS/test/test_*
/ew_gui_tools/pickS/test/gen_tank
!/ew_gui_tools/pickS/test/test_*.c
!/ew_gui_tools/pickS/test/test_*.sh
/ew_gui_tools/hyp2000_ring/hyp2000_ring
/ew_gui_tools/hyp2000_ring/test/test_*
!/ew_gui_tools/hyp2000_ring/test/test_*.c
/ew_gui_tools/nlloc_ring/nlloc_ring
/ew_gui_tools/nlloc_ring/nlloc/Vel2Grid
/ew_gui_tools/nlloc_ring/nlloc/Grid2Time

# --- ejemplos/referencias no versionados ---
/ew_gui_tools/hyp2000_ring/hyp2000_mgr.c.ref
/ew_gui_tools/hyp2000_ring/hypoinverse/makefile.unix.ref
/ew_gui_tools/hyp2000_ring/ncal2000.hyp

# --- runtime ---
/run_working_v8/log/

# --- 5. run_working_v8/params: SOLO configuracion versionada ----------------
# `earthworm.d` se GENERA a partir de `earthworm.d.base` (versionado, offset 0)
# con las keys de anillo de la instancia: ew_gui_tools/common/tools/worktree_bootstrap.sh
/run_working_v8/params/earthworm.d
# Ningun modulo NUESTRO escribe aqui. Las dos unicas salvedades son el estado
# interno de binarios de FABRICA (no tienen clave de ruta en su .d) y su sufijo es
# su id de modulo (earthworm.d: MOD_SLINK2EW 126, MOD_PICK_FP 151): se ignoran por
# patron para que un cambio de id no los deje a la vista.
/run_working_v8/params/slink*.state
/run_working_v8/params/pick_FP_*.ndx
# Respaldos y temporales (ew_controller guarda un .d: <mod>.d.bak/.tmp).
/run_working_v8/params/*.bak
/run_working_v8/params/*.bak.*
/run_working_v8/params/*.bak_*
/run_working_v8/params/*.tmp
/run_working_v8/params/_legacy_atwc/
/run_working_v8/params/*.log

# ===========================================================================
# Patrones generales (red de seguridad)
# ===========================================================================
._*
.DS_Store
*.pid
*.swp
*~
core
core.*
__pycache__/
*.pyc
# Carpeta de pruebas de integracion de localizadores (NLL, HYP2000, etc.)
tmp/
# Datos grandes requeridos en runtime (nlloc, hyp2000, csnmags): no se versionan.
/resources/

# Dependencias de cabeceras que genera el build (-MMD -MF $(@).dep).
# OJO: *.d NO se ignora: los .d de los modulos son configuraciones versionadas
# (ew_controller.d, test/csnloc_offline.d, test/csnmags_test.d).
*.dep

# --- csnmags (motor de magnitudes) ---
/run_working_v8/params/responses/
/ew_gui_tools/csnmags/csnmags
/ew_gui_tools/csnmags/*.o
/ew_gui_tools/csnmags/test/tmp/
/ew_gui_tools/csnmags/test/responses/
/ew_gui_tools/csnmags/test/test_formula
/ew_gui_tools/csnmags/test/test_amp
/ew_gui_tools/csnmags/test/test_pz
/ew_gui_tools/csnmags/test/test_config
/ew_gui_tools/csnmags/test/gen_tank
/ew_gui_tools/csnmags/test/gen_hypos
