C--HYPOINVERSE CRUSTAL MODELS ********************************************
C--DATA PRESENT FOR EACH OF THE LH=LM MODELS (CRH,CRL,CRE)
C--LH IS THE MAX NO. OF LAYER MODELS WHICH MUST = LM, THE MAX NO. OF MODELS
      INTEGER    NLYR
      PARAMETER (NLYR=20)
      INTEGER    LH
      PARAMETER (LH=36)
      CHARACTER   MODNAM*30
      COMMON /MC/ MODNAM(LH)    !MODEL NAME OR LABEL
