/* --- ESTRUCTURA PURA SCNL PARA ESTACIONES --- */
typedef struct {
    double x1, x2, y1, y2;
    double b0, b1, b2, a1, a2;
} BIQUAD;

typedef struct {
    BIQUAD bq[2];        
    gboolean initialized;
    double last_time;    
} IIR_FILTER;

typedef struct {
    double dTime;       
    char szPhase[8];    
} PICK;

#define MAX_PICKS_PER_STA 50

typedef struct {
    char szStation[16];
    char szChannel[16];
    char szNetID[16];
    char szLocation[16]; 
    double dLat;
    double dLon;
    
    int32_t *plRawCircBuff;
    int32_t *plFiltCircBuff;
    long lRawCircSize;
    long lRawCircCtr;
    
    double dSampRate;     
    double dOldestTime;   
    double dScreenScale;  
    
    int64_t lLastAbsIdx; 
    
    double dManualPickTime; 
    
    PICK picks[MAX_PICKS_PER_STA];
    int iNumPicks;

    IIR_FILTER filter;
} DEV_STATION;

/* --- SISTEMA DE CACHE DE PICKS PARA EVENTOS HISTORICOS --- */
#define MAX_CACHED_EVENTS 50
#define MAX_PICKS_PER_EVENT 200

typedef struct {
    char sta[8];
    char chan[8];
    char phase[8];
    double pTime;
} CACHED_PICK;

typedef struct {
    int qid;
    int num_picks;
    CACHED_PICK picks[MAX_PICKS_PER_EVENT];
} EVENT_PICK_CACHE;

EVENT_PICK_CACHE PickCache[MAX_CACHED_EVENTS];
int pick_cache_idx = 0;

